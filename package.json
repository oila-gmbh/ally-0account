{
  "name": "@oila-gmbh/ally-0account",
  "description": "AdonisJS Ally driver for 0account sign-in",
  "version": "0.2.0",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    }
  },
  "type": "module",
  "files": [
    "build/index.js",
    "build/index.d.ts",
    "build/src"
  ],
  "repository": "https://github.com/oila-gmbh/ally-0account.git",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "lint": "eslint . --ext=.ts",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run lint",
    "test": "node --enable-source-maps --loader ts-node/esm bin/test.ts",
    "build": "tsc"
  },
  "devDependencies": {
    "@adonisjs/ally": "^6.3.1",
    "@adonisjs/core": "^7.6.0",
    "@adonisjs/eslint-config": "^1.3.0",
    "@adonisjs/prettier-config": "^1.3.0",
    "@adonisjs/tsconfig": "^1.3.0",
    "@japa/assert": "^4.2.0",
    "@japa/runner": "^5.3.0",
    "@swc/core": "^1.6.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "peerDependencies": {
    "@adonisjs/ally": "^6.0.0",
    "@adonisjs/core": "^7.0.0"
  },
  "author": "oila-gmbh",
  "license": "MIT",
  "keywords": [
    "social-auth",
    "adonisjs-ally",
    "adonisjs",
    "oauth2",
    "openid-connect",
    "zeroaccount",
    "0account"
  ],
  "eslintConfig": {
    "extends": "@adonisjs/eslint-config/package"
  },
  "prettier": "@adonisjs/prettier-config"
}
